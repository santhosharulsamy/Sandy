# Sandy standard library: sorting.
#
#     import "sort" as sort
#     print(sort.sort([3, 1, 2]))          # [1, 2, 3]
#     print(sort.sort_by(words, len))      # shortest first
#
# A stable insertion sort that works on any values comparable with `<`
# (numbers or strings). The input list is never modified — a new list is
# returned.

fn sort(xs) {
    out = []
    for x in xs { push(out, x) }
    i = 1
    while i < len(out) {
        key = out[i]
        j = i - 1
        while j >= 0 and out[j] > key {
            out[j + 1] = out[j]
            j -= 1
        }
        out[j + 1] = key
        i += 1
    }
    return out
}

fn sort_by(xs, key) {
    out = []
    for x in xs { push(out, x) }
    i = 1
    while i < len(out) {
        cur = out[i]
        ck = key(cur)
        j = i - 1
        while j >= 0 and key(out[j]) > ck {
            out[j + 1] = out[j]
            j -= 1
        }
        out[j + 1] = cur
        i += 1
    }
    return out
}

fn sort_desc(xs) {
    ascending = sort(xs)
    out = []
    i = len(ascending) - 1
    while i >= 0 {
        push(out, ascending[i])
        i -= 1
    }
    return out
}

fn is_sorted(xs) {
    i = 1
    while i < len(xs) {
        if xs[i - 1] > xs[i] { return false }
        i += 1
    }
    return true
}
